

# Retry behavior for LLM calls (optional)
CRPB_LLM_RETRIES=2
CRPB_LLM_RETRY_BACKOFF=1.0

# Planning refinement (optional)
# Number of validate/refine rounds for initial plan generation.
# Bounds: 0-5. Default: 2. Constraints.plan_refine_max_rounds overrides this.
CRPB_PLAN_REFINE_MAX_ROUNDS=2

# TaskPlan node-level refinement (optional)
# Number of clarify refine rounds per TaskSpec node and per newly created child during execution.
# Bounds: 0-5. Default: 2. constraints.taskplan_refine_max_rounds overrides this.
CRPB_TASKPLAN_REFINE_MAX_ROUNDS=1

# Function-level planning refinement (optional)
# Number of validate/refine rounds for each function spec within files during planning.
# Bounds: 0-5. Default: 2. constraints.plan_function_refine_max_rounds overrides this.
CRPB_PLAN_FUNCTION_REFINE_MAX_ROUNDS=1

# LM generation settings (optional)
# Keep defaults high to avoid truncation; override locally if needed
# Max tokens to request/generate (used as both max_tokens and max_new_tokens when supported)
# Default if unset: 32768
CRPB_LM_MAX_TOKENS=40000
# Sampling temperature; when unset or empty, no override is passed (uses library/DSPy default)
CRPB_LM_TEMPERATURE=

############################################
# Additional provider-neutral configuration #
############################################
# Default provider selection (env overrides any saved .crpb_llm.json)
# Keep blank by default to avoid hidden preferences; choose explicitly:
#   openai | anthropic | cerebras | azure_foundry | local | server
CRPB_LLM_PROVIDER=

# Optional generic model/base_url overrides used when CRPB_LLM_PROVIDER is set.
# Prefer provider-specific model vars (e.g., CRPB_CEREBRAS_MODEL) unless you intentionally want a generic override.
CRPB_LLM_MODEL=
CRPB_LLM_BASE_URL=

# IMPORTANT: Do not commit real secrets. Use a placeholder here or set via shell/CI.
OPENAI_API_KEY=
CRPB_OPENAI_MODEL=

############################################
# Lossless log/event externalization knobs  #
############################################
# If an event message exceeds this size, it is externalized to runs/<run>/artifacts/messages/
CRPB_EVENT_MAX_MESSAGE_CHARS=800
# If a list exceeds this count, it is externalized to runs/<run>/artifacts/lists/
CRPB_EVENT_MAX_LIST_ITEMS=200

# CLI display limits (display is bounded; full data is always available by ref/rollup)
CRPB_STATUS_TAIL=50
CRPB_STATUS_MAX_TASKS=100
CRPB_REPLAY_MAX_TASKS=100

# Embeddings (optional, disabled by default)
# Embeddings-backed features are opt-in and require:
#   - CRPB_EMBEDDINGS_ENABLE=true
#   - CRPB_TASK_EMBED_PROVIDER_PREFERENCE set (e.g., voyage,openai)
#   - provider API key + embed model env var
CRPB_EMBEDDINGS_ENABLE=false

# Set VOYAGE_API_KEY / OPENAI_API_KEY in your local .env if you intend to use embeddings.
VOYAGE_API_KEY=
# Choose providers explicitly (comma-separated). Example: voyage,openai
CRPB_TASK_EMBED_PROVIDER_PREFERENCE=

# Optional embedding model overrides (leave blank unless enabling embeddings)
CRPB_VOYAGE_EMBED_MODEL=
CRPB_OPENAI_EMBED_MODEL=

# Embeddings-driven task dedup knobs (optional)
CRPB_TASK_DEDUP_MAX_LEAF_QUERIES=12
CRPB_TASK_DEDUP_MIN_SIM=0.84

CRPB_TASK_EMBED_MAX_TITLE_CHARS=160
CRPB_TASK_EMBED_MAX_SUMMARY_CHARS=600

CRPB_TASK_EMBED_BATCH_SIZE=64
CRPB_TASK_EMBED_RETRIES=2
CRPB_TASK_EMBED_RETRY_BACKOFF=1.0
CRPB_VOYAGE_EMBED_TIMEOUT_S=30
CRPB_OPENAI_EMBED_TIMEOUT_S=30

CRPB_TREE_VALIDATION_ENABLE=
CRPB_TREE_VALIDATION_MAX_NODES=30
CRPB_TREE_VALIDATION_MAX_CHILDREN=12
CRPB_TREE_VALIDATION_MAX_SIBLINGS=8
CRPB_TREE_VALIDATION_SIM_TOP_K=6
CRPB_TREE_VALIDATION_SIM_MIN_SCORE=0.82

CRPB_PROJECT_VALIDATE_MAX_CHARS=60000
CRPB_PROJECT_VALIDATE_MAX_FILES=20

# Optional: set a default model for OpenAI (no built-in defaults assumed)
# CRPB_OPENAI_MODEL=
# Anthropic (Claude)
ANTHROPIC_API_KEY=
# Optional: set a default model for Anthropic (no built-in defaults assumed)
# CRPB_ANTHROPIC_MODEL=

# Cerebras (Fast AI inference)
CEREBRAS_API_KEY=
# Optional: set a default model for Cerebras
CRPB_CEREBRAS_MODEL=

# Azure AI Foundry (OpenAI-compatible deployments)
# Provide the resource endpoint (no path) and deployment name.
# Example endpoint: https://<resource-name>.cognitiveservices.azure.com
CRPB_AZURE_FOUNDRY_ENDPOINT=
CRPB_AZURE_FOUNDRY_API_VERSION=
CRPB_AZURE_FOUNDRY_DEPLOYMENT=
# Secret (do not commit):
CRPB_AZURE_FOUNDRY_API_KEY=

# Hugging Face (some public models may not require a token)
# You can set a default model via env instead of storing it in .crpb_llm.json
CRPB_HF_MODEL=
# If needed, set one of the following:
HUGGINGFACEHUB_API_TOKEN=
# or
HF_TOKEN=

# Local provider: requires no env keys. Choose model via
#   crpb llm choose --provider local --model <your-local-model-id>
# The model can be a simple name (e.g., "my-model") or a filesystem path string if
# your local runtime resolves models by path.
# Optional keys for local runtimes that support auth (not required by default)
CRPB_LOCAL_API_KEY=

# Server provider: typically requires no env keys. Configure via CLI with both base_url and model, e.g.:
#   crpb llm choose --provider server --base-url http://localhost:11434 --model llama3
# Optional API key(s) in case your server is protected (not required by default)
CRPB_SERVER_API_KEY=

# Validator strictness
# Strictness is defined in code (see crpb/validator.py). There are no environment toggles for validator behavior.